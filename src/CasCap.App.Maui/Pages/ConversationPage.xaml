<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CasCap.Models"
             xmlns:views="clr-namespace:CasCap.Views"
             x:Class="CasCap.Pages.ConversationPage"
             Title="Tutor">
    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="CopyConversationItem" Text="Copy conversation"
                     Order="Secondary" Clicked="OnCopyConversationClicked" IsEnabled="False" />
        <ToolbarItem x:Name="ClearMessagesItem" Text="Clear messages"
                     Order="Primary" Clicked="OnClearMessagesClicked" IsEnabled="False" />
    </ContentPage.ToolbarItems>
    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="24" RowSpacing="16">
        <VerticalStackLayout Spacing="4">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label x:Name="StateLabel" Style="{StaticResource SectionTitleLabelStyle}" />
                <Label Grid.Column="1" x:Name="ElapsedLabel" IsVisible="False"
                       VerticalOptions="Center" SemanticProperties.Description="Elapsed call time" />
            </Grid>
            <HorizontalStackLayout x:Name="MicrophoneIndicator" Spacing="8" IsVisible="False">
                <Ellipse x:Name="MicrophoneDot" WidthRequest="14" HeightRequest="14" Fill="Gray" VerticalOptions="Center" />
                <Label x:Name="MicrophoneLabel" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Label x:Name="DetailLabel" Style="{StaticResource IntroLabelStyle}" />
            <Button x:Name="CopyErrorButton" Text="Copy error" Clicked="OnCopyErrorClicked"
                    IsVisible="False" HorizontalOptions="Start" />
            <VerticalStackLayout x:Name="SpeechPaceControls" Spacing="4" IsVisible="False">
                <Label Text="Speech pace" />
                <HorizontalStackLayout Spacing="8">
                    <Button x:Name="SlowPaceButton" Text="Slow" Clicked="OnSpeechPaceClicked" />
                    <Button x:Name="NormalPaceButton" Text="Normal" Clicked="OnSpeechPaceClicked" />
                    <Button x:Name="FastPaceButton" Text="Fast" Clicked="OnSpeechPaceClicked" />
                </HorizontalStackLayout>
                <Label x:Name="SpeechPaceLabel" />
            </VerticalStackLayout>
        </VerticalStackLayout>
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
            <Button x:Name="StartButton" Text="New" Clicked="OnStartClicked"
                    SemanticProperties.Hint="Signs you in if needed and starts a live call with the tutor" />
            <Button Grid.Column="1" x:Name="ResumeButton" Text="Resume" Clicked="OnResumeClicked"
                    SemanticProperties.Hint="Starts a new audio connection with your last retained conversation" />
            <Button Grid.Column="2" x:Name="MuteButton" Text="Mute" Clicked="OnMuteClicked"
                    SemanticProperties.Hint="Stops or resumes sending your microphone" />
            <Button Grid.Column="3" x:Name="EndButton" Text="End" Clicked="OnEndClicked"
                    SemanticProperties.Hint="Ends the call and releases the microphone" />
        </Grid>
        <CollectionView Grid.Row="2" x:Name="TranscriptView" SelectionMode="None"
                        ItemsUpdatingScrollMode="KeepLastItemInView">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TranscriptMessage">
                    <Grid ColumnDefinitions="*,5*,*">
                        <Border Grid.ColumnSpan="2" Margin="0,4" Padding="12" StrokeThickness="0"
                                HorizontalOptions="Start"
                                BackgroundColor="{AppThemeBinding Light={StaticResource TutorBubbleLight}, Dark={StaticResource TutorBubbleDark}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsLearner}" Value="True">
                                    <Setter Property="Grid.Column" Value="1" />
                                    <Setter Property="HorizontalOptions" Value="End" />
                                    <Setter Property="BackgroundColor"
                                            Value="{AppThemeBinding Light={StaticResource LearnerBubbleLight}, Dark={StaticResource LearnerBubbleDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <views:TranscriptMessageLayout CopyClicked="OnCopyMessageClicked" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <!-- Hosts the WebRTC media engine; it has no visible content. -->
        <HybridWebView Grid.Row="3" x:Name="CallView" HeightRequest="1"
                       RawMessageReceived="OnCallViewRawMessageReceived"
                       WebViewInitialized="OnCallViewInitialized" />
    </Grid>
</ContentPage>
