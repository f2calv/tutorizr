<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CasCap.Pages.ConversationPage"
             Title="Tutor">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Padding="24" RowSpacing="16">
        <Label Text="Live tutor" Style="{StaticResource PageTitleLabelStyle}" SemanticProperties.HeadingLevel="Level1" />
        <Label Grid.Row="1" Style="{StaticResource IntroLabelStyle}"
               Text="While a call is active your voice is streamed to Azure OpenAI through a call brokered by the Agentizr runtime. This app does not store audio or transcripts." />
        <VerticalStackLayout Grid.Row="2" Spacing="4">
            <Label x:Name="StateLabel" Style="{StaticResource SectionTitleLabelStyle}" />
            <HorizontalStackLayout x:Name="MicrophoneIndicator" Spacing="8" IsVisible="False">
                <Ellipse x:Name="MicrophoneDot" WidthRequest="14" HeightRequest="14" Fill="Gray" VerticalOptions="Center" />
                <Label x:Name="MicrophoneLabel" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Label x:Name="DetailLabel" Style="{StaticResource IntroLabelStyle}" />
        </VerticalStackLayout>
        <HorizontalStackLayout Grid.Row="3" Spacing="12">
            <Button x:Name="StartButton" Text="Start" Clicked="OnStartClicked"
                    SemanticProperties.Hint="Signs you in if needed and starts a live call with the tutor" />
            <Button x:Name="MuteButton" Text="Mute" Clicked="OnMuteClicked"
                    SemanticProperties.Hint="Stops or resumes sending your microphone" />
            <Button x:Name="EndButton" Text="End" Clicked="OnEndClicked"
                    SemanticProperties.Hint="Ends the call and releases the microphone" />
        </HorizontalStackLayout>
        <ScrollView Grid.Row="4" x:Name="TranscriptScroll">
            <Label x:Name="TranscriptLabel" />
        </ScrollView>
        <!-- Hosts the WebRTC media engine; it has no visible content. -->
        <HybridWebView Grid.Row="5" x:Name="CallView" HeightRequest="1"
                       RawMessageReceived="OnCallViewRawMessageReceived"
                       WebViewInitialized="OnCallViewInitialized" />
    </Grid>
</ContentPage>
