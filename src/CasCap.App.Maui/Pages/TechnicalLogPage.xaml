<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CasCap.Pages.TechnicalLogPage"
             Title="Technical Log">
    <Grid Padding="24" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
        <Label Text="Technical Log" Style="{StaticResource PageTitleLabelStyle}" SemanticProperties.HeadingLevel="Level1" />
        <Label Grid.Row="1" Text="Recent call setup results, newest first. They stay on this device until you close the app." />
        <HorizontalStackLayout Grid.Row="2" Spacing="8">
            <Button x:Name="CopyLogButton" Text="Copy log" Clicked="OnCopyClicked" />
            <Button x:Name="ClearLogButton" Text="Clear log" Clicked="OnClearClicked" />
        </HorizontalStackLayout>
        <ScrollView Grid.Row="3">
            <Label x:Name="LogLabel" />
        </ScrollView>
    </Grid>
</ContentPage>
