{
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft.AspNetCore": "Warning",
                "Microsoft.AspNetCore.Authentication": "Error",
                "Microsoft.Extensions.Http": "Information",
                "System.Net.Http.HttpClient": "Warning"
            }
        }
    },
    "AllowedHosts": "*",
    "AppConfig": {
        "KeyVaultName": "my-keyvault",
        "AzureEntraTenantId": "00000000-0000-0000-0000-000000000000",
        "OtlpExporterEndpoint": null,
        "McpUrl": "/mcp"
    },
    "CasCap": {
        "FeatureConfig": {
            "EnabledFeatures": "Comms,Mcp"
        },
        "CachingConfig": {
            "RemoteCacheConnectionString": "localhost:6379,abortConnect=false,connectTimeout=1000",
            "RemoteCache": {
                "SerializationType": "Json"
            }
        },
        "TutorConfig": {
            "TargetLevel": "B1",
            "ProfileKey": "tutor:snapshot:profile",
            "VocabularyKey": "tutor:snapshot:vocabulary",
            "VocabularyDueKey": "tutor:series:vocabulary-due",
            "MistakesKey": "tutor:series:mistakes",
            "MaxMistakes": 500
        },
        "SpeechToTextConfig": {
            "Mode": "Disabled",
            "Provider": "WhisperAsr",
            "WhisperAsrEndpoint": "http://localhost:9000",
            "WhisperCppEndpoint": null,
            "AzureEndpoint": null,
            "AzureLocales": null,
            "Language": "de",
            "TimeoutMs": 120000,
            "MaxCompressedBytes": 5242880,
            "MaxDecodedBytes": 19200000,
            "MaxDurationSeconds": 300,
            "FfmpegPath": "ffmpeg"
        },
        "TextToSpeechConfig": {
            "Mode": "Disabled",
            "Provider": "AzureSpeech",
            "AzureSpeechEndpoint": null,
            "AzureOpenAiEndpoint": null,
            "AzureOpenAiDeployment": null,
            "AzureOpenAiApiVersion": "2025-03-01-preview",
            "AzureSpeechVoice": "de-DE-KatjaNeural",
            "AzureOpenAiVoice": null,
            "PiperEndpoint": null,
            "PiperVoice": null,
            "FfmpegPath": "ffmpeg",
            "MaxCharacters": 1000,
            "TimeoutMs": 60000
        },
        "VoiceMetricsConfig": {
            "MetricNamePrefix": "tutorizr"
        },
        "CommsMetricsConfig": {
            "MetricNamePrefix": "tutorizr"
        },
        "CommsConfig": {
            "GroupName": "Tutorizr",
            "MonitorGroupName": "Tutorizr Monitor",
            "MonitorContentEnabled": false,
            "EchoTranscriptToDebugChat": false,
            "FooterTokenCountsEnabled": false,
            "FooterSessionSizeEnabled": false,
            "FooterSessionCountsEnabled": false,
            "StreamKey": "comms:stream:tutorizr",
            "ConsumerGroup": "comms:tutorizr",
            "AgentName": "TutorAgent",
            "AgentSessionId": "primary-group",
            "AgentDefaultPrompt": "Beschreibe diesen Anhang auf Deutsch."
        },
        "AgentRuntimeClientOptions": {
            "BaseAddress": "http://localhost:5090",
            "TimeoutMinutes": 10
        },
        "AgentRuntimeAzureAuthConfig": {
            "Enabled": false,
            "TenantId": null,
            "ClientId": null,
            "Certificate": null,
            "Scope": null
        },
        "SignalizrClientConfig": {
            "BaseAddress": "http://localhost:8090",
            "GrpcAddress": "http://localhost:5001",
            "SubscriberName": "tutorizr-comms"
        }
    }
}